# copy to .env and fill in real values. never commit .env.
# this file documents every variable the stack reads.

# --- shared ---
ENVIRONMENT=development

# --- database (postgres) ---
POSTGRES_USER=itai
POSTGRES_PASSWORD=change-me
POSTGRES_DB=itai
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# full url is derived from the parts above; override only if needed
DATABASE_URL=postgresql+psycopg://itai:change-me@postgres:5432/itai

# --- cache / message broker (redis) ---
REDIS_URL=redis://redis:6379/0

# --- api ---
API_HOST=0.0.0.0
API_PORT=8000
# comma-separated origins allowed by cors
API_CORS_ORIGINS=http://localhost:3000
# secret used for signing tokens (generate a long random value)
API_SECRET_KEY=change-me
# file-backed benchmark registry the experiment api reads/writes
BENCHMARK_STORE_PATH=var/benchmarks.json

# --- worker ---
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- web (next.js) ---
# must be prefixed with NEXT_PUBLIC_ to be exposed to the browser
NEXT_PUBLIC_API_URL=http://localhost:8000
